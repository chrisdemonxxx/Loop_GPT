# Backend API base URL (build-time; inlined into the client bundle).
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Analytics / error monitoring (optional; inert if unset) ----
# PostHog product analytics / funnel. Project key from posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry client error monitoring. DSN from sentry.io.
NEXT_PUBLIC_SENTRY_DSN=
