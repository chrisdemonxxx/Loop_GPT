{
  "$schema": "https://raw.githubusercontent.com/json-schema-org/json-schema-spec/draft-07/json-schema-validation.txt",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "no-constant-condition": ["error", { "checkLoops": false }]
  }
}
