{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "shared/src/**/*.ts",
    "api-client/src/**/*.ts",
    "ui/src/**/*.ts",
    "ui/src/**/*.tsx",
    "loopit-contracts/src/**/*.ts",
    "loopit-client/src/**/*.ts"
  ]
}
