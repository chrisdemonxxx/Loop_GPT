{
  "name": "loopgpt-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"try{var f=require.resolve('expo/package.json').replace('package.json','')+'android/build.gradle';var c=require('fs').readFileSync(f,'utf8');if(c.includes('\\\"ExpoModulesCorePlugin.gradle\\\"')){c=c.replace('\\\"ExpoModulesCorePlugin.gradle\\\"','\\\"android/ExpoModulesCorePlugin.gradle\\\"');require('fs').writeFileSync(f,c)}}catch(e){}\""
  },
  "dependencies": {
    "@react-native/gradle-plugin": "^0.76.7",
    "expo": "^52.0.37",
    "expo-asset": "^57.0.18",
    "expo-modules-core": "~2.2.3",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.6.3"
  }
}
