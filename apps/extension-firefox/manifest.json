{
  "manifest_version": 3,
  "name": "Loop GPT",
  "version": "1.0.0",
  "description": "Drive a visible window from Loop Chat, Build, and Loop Bot.",
  "browser_specific_settings": {
    "gecko": {
      "id": "loop-gpt@loop-gpt.cyou",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loop GPT"
  }
}
