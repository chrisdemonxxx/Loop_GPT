# Server configuration. Copy to `.env` and fill in real values locally; never
# commit `.env`. Every variable here is read server-side only. The browser never
# sees these — client config lives in VITE_-prefixed variables (see below).

# PostgreSQL connection string. The app connects as a role that is (or inherits)
# app_user, NOT as the table owner, so row-level security actually applies.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/app

# Secret used to verify JWT bearer tokens. Must match the issuer (e.g. GoTrue).
# Generate a long random value; do not reuse across environments.
JWT_SECRET=CHANGE_ME_use_a_long_random_value

# Allowlisted algorithms for JWT verification. HS256 for a shared secret.
JWT_ALGORITHMS=HS256

# Comma-separated list of exact origins allowed by CORS. Never use "*" with
# credentials. Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Port the API server listens on.
PORT=8080

# --- Client (browser) configuration ---
# Only VITE_-prefixed variables are bundled into the frontend. Put nothing
# secret here — anything with this prefix ships to every user's browser.
VITE_API_BASE_URL=http://localhost:8080
