# Copy to .env for docker compose, or generate secure local values with:
# uv run python scripts/generate_secrets.py
#
# Secret values are intentionally blank here. Runtime loaders reject missing,
# short, and placeholder-like values.

POSTGRES_DB=loopit
POSTGRES_USER=loopit
POSTGRES_PASSWORD=
LOOPIT_ENV=dev
DATABASE_URL=
LOOPIT_STORE_DSN=
LOOPIT_POSTGRES_DSN=
LOOPIT_CHECKPOINT_BLOB_DIR=/var/lib/loopit/checkpoint-blobs
LOOPIT_AUDIT_DSN=
LOOPIT_AUDIT_ROLE_PASSWORD=
# Set to 1 only for local unit tests/dev processes with intentionally volatile audit logs.
LOOPIT_AUDIT_EPHEMERAL=0
LOOPIT_PUBLIC_URL=http://localhost:8080
LOOPIT_REDIS_URL=
LOOPIT_OBJECT_STORAGE_ENDPOINT=
LOOPIT_OBJECT_STORAGE_BUCKET=
LOOPIT_MODEL_ENDPOINT=
LOOPIT_SANDBOX_PROVIDER=
# Compose's local Docker sandbox provider mounts the host Docker socket into
# scheduler and workspace-dispatch. This grants effective host-root control to
# those services; use only in trusted local/self-hosted deployments, and set the
# group id to `stat -c %g /var/run/docker.sock` on Linux if the default is wrong.
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SOCKET_GID=0

API_PORT=8000
API_PUBLISHED_PORT=8000
WEB_PORT=8080
WEB_PUBLISHED_PORT=8080
ROUTER_PORT=8001
EGRESS_PROXY_PORT=8002
PREVIEW_PROXY_PORT=8003
PREVIEW_PROXY_PUBLISHED_PORT=8003
APP_PROXY_PORT=8009
APP_PROXY_PUBLISHED_PORT=8009
SCHEDULER_PORT=8004
WORKSPACE_DISPATCH_PORT=8005
WORKSPACE_DISPATCH_PUBLISHED_PORT=8005
ABUSE_ENGINE_PORT=8007
ADMIN_PORT=8081
ADMIN_PUBLISHED_PORT=8081
BILLING_PORT=8006
DOMAINS_PORT=8008
DOMAINS_PUBLISHED_PORT=8008
TEMPORAL_PUBLISHED_PORT=7233

LOOPIT_API_BASE_URL=http://api:8000
LOOPIT_ROUTER_URL=http://router-svc:8001
LOOPIT_EGRESS_PROXY_URL=http://egress-proxy:8002
LOOPIT_PREVIEW_PROXY_URL=http://preview-proxy:8003
LOOPIT_APP_PROXY_URL=http://app-proxy:8009
LOOPIT_SCHEDULER_URL=http://scheduler:8004
LOOPIT_WORKSPACE_DISPATCH_URL=http://workspace-dispatch:8005/dispatch
LOOPIT_ABUSE_URL=http://abuse-engine:8007
LOOPIT_BILLING_URL=http://billing:8006
LOOPIT_DOMAINS_URL=http://domains:8008
LOOPIT_PROJECTS=/var/lib/loopit/projects
PREVIEW_PUBLIC_BASE_URL=http://localhost:8003
LOOPIT_IDENTITY_ISSUER=loopit-gateway
LOOPIT_IDENTITY_AUDIENCE=loopit-control-plane
LOOPIT_IDENTITY_KID=dev
LOOPIT_IDENTITY_SECRET=
LOOPIT_OPERATOR_IDENTITY_ISSUER=loopit-operator
LOOPIT_OPERATOR_IDENTITY_AUDIENCE=loopit-platform-operator
LOOPIT_OPERATOR_IDENTITY_KID=operator-1
LOOPIT_OPERATOR_IDENTITY_SECRET=
LOOPIT_OPERATOR_TOKEN_TTL_SECONDS=900
LOOPIT_PREVIEW_SIGNING_KEY=
LOOPIT_LEASE_TOKEN_SECRET=
LOOPIT_SERVICE_TOKEN=
LOOPIT_MODEL_API_KEY=
LOOPIT_SANDBOX_SIGNING_KEY=

# Public deployed app edge. TLS is terminated upstream by the ingress that owns
# certificates from services/domains; compose exposes HTTP for local/dev use.
LOOPIT_APP_PROXY_HOSTNAMES=[]
LOOPIT_APP_PROXY_BACKENDS=[]
LOOPIT_APP_PROXY_ROUTE_POSITIVE_TTL_SECONDS=3
LOOPIT_APP_PROXY_ROUTE_NEGATIVE_TTL_SECONDS=1
LOOPIT_APP_PROXY_ROUTE_LOOKUP_TIMEOUT_SECONDS=1.5
LOOPIT_APP_PROXY_MAX_REQUEST_BYTES=10485760
LOOPIT_APP_PROXY_REQUEST_BODY_TIMEOUT_SECONDS=10
LOOPIT_APP_PROXY_UPSTREAM_TIMEOUT_SECONDS=30
LOOPIT_APP_PROXY_WEBSOCKET_OPEN_TIMEOUT_SECONDS=10
LOOPIT_APP_PROXY_WEBSOCKET_IDLE_TIMEOUT_SECONDS=60
LOOPIT_APP_PROXY_RATE_LIMIT_PER_MINUTE=600
LOOPIT_APP_PROXY_HOSTING_EGRESS_FLUSH_BYTES=1000000
LOOPIT_APP_PROXY_HOSTING_EGRESS_FLUSH_INTERVAL_SECONDS=5

HF_BASE_URL=https://router.huggingface.co
HF_BILL_TO=
HF_TOKEN=
LOOPIT_ROUTER_POLICY=huggingface-unrestricted
LOOPIT_ENDPOINT_GLM_FLASH_URL=
LOOPIT_ENDPOINT_QWEN38_URL=
LOOPIT_ENDPOINT_GLM53_URL=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/billing/success
STRIPE_CANCEL_URL=http://localhost:8080/billing/cancel
LOOPIT_BILLING_PRICE_TABLE_JSON=

LOOPIT_TEMPORAL_ADDRESS=temporal:7233
LOOPIT_TEMPORAL_NAMESPACE=default
LOOPIT_TEMPORAL_TASK_QUEUE=loopit-runs

# OpenTelemetry / Grafana Cloud (leave empty for no-op local services)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_PROM_PORT=9464
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=

# Enforcement is on by default. Set to 1 only for audits/drills; preflight fails for production.
LOOPIT_ABUSE_DRY_RUN=0
# Developer-only total auth bypass. Must remain unset/0 in production; preflight fails when enabled
# unless LOOPIT_ENV is dev/development/local and all marker hosts are local.
LOOPIT_DEV_SINGLE_TENANT=0
LOOPIT_ADMIN_API_BASE_URL=http://localhost:8007

# Generated app Git sync / production deploy (operator-provided in live envs)
LOOPIT_GITSYNC_PROVIDER=github
LOOPIT_GITHUB_OWNER=
LOOPIT_GITHUB_APP_TOKEN=
LOOPIT_DEPLOYER_PROVIDER=fly
LOOPIT_DEPLOYER_PUBLIC_BASE_DOMAIN=localhost
LOOPIT_DEPLOYER_MAX_APPS=25
LOOPIT_DEPLOYER_MAX_MACHINE_MEMORY_MB=512
LOOPIT_FLY_API_TOKEN=
LOOPIT_FLY_ORG=
LOOPIT_PROVISION_POSTGRES_DSN=
LOOPIT_STORAGE_BUCKET=loopit-generated-apps

# Domains service. Cloudflare values are read only when LOOPIT_DOMAINS_DNS_PROVIDER=cloudflare.
LOOPIT_APPS_BASE_DOMAIN=loopit.app
LOOPIT_APP_PROXY_DNS_TARGET=app-proxy
LOOPIT_DOMAINS_DNS_PROVIDER=memory
LOOPIT_PLATFORM_HOSTNAMES=
LOOPIT_SUBDOMAIN_BRAND_DENYLIST=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
