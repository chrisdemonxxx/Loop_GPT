{
  "uid": "loopit-golden-signals",
  "title": "Loop-it Golden Signals",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["loopit", "observability"],
  "panels": [
    {"type":"timeseries","title":"Request rate","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"datasource":{"type":"prometheus","uid":"Prometheus"},"expr":"sum(rate(loopit_request_count_total[5m])) by (service)","legendFormat":"{{service}}"}]},
    {"type":"timeseries","title":"Error rate","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"datasource":{"type":"prometheus","uid":"Prometheus"},"expr":"sum(rate(loopit_request_errors_total[5m])) by (service)","legendFormat":"{{service}}"}]},
    {"type":"timeseries","title":"p95 duration (ms)","gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"datasource":{"type":"prometheus","uid":"Prometheus"},"expr":"histogram_quantile(0.95, sum(rate(loopit_request_duration_ms_bucket[5m])) by (le, service))","legendFormat":"{{service}}"}]},
    {"type":"timeseries","title":"Saturation","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"datasource":{"type":"prometheus","uid":"Prometheus"},"expr":"loopit_saturation","legendFormat":"{{service}} {{resource}}"}]}
  ]
}
