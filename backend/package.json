{
  "name": "loop-gpt-backend",
  "version": "1.0.0",
  "description": "Backend API for Loop GPT",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "make-admin": "node scripts/make-admin.mjs",
    "worker:daily-settlement": "node scripts/daily-settlement-worker.mjs",
    "worker:api-settlement": "node scripts/api-settlement-worker.mjs",
    "worker:video": "node scripts/video-job-worker.mjs",
    "private-storage": "node scripts/private-storage.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mozilla/readability": "^0.5.0",
    "@prisma/client": "^5.7.1",
    "@sentry/node": "^8.47.0",
    "@types/nodemailer": "^8.0.1",
    "ajv": "8.20.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.0.2",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsdom": "^24.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.3",
    "multer": "2.4.0",
    "node-cron": "^4.6.0",
    "node-fetch": "2.7.0",
    "nodemailer": "^9.0.3",
    "openai": "^4.20.1",
    "otplib": "^13.5.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pptxgenjs": "^3.12.0",
    "prisma": "^5.7.1",
    "stripe": "^22.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "2.2.0",
    "@types/node": "^20.10.6",
    "@types/node-fetch": "2.6.13",
    "@types/pdfkit": "^0.13.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
