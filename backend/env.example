# Database
DATABASE_URL=postgresql://user:password@localhost:5432/loopgpt

# JWT
JWT_SECRET=your-secret-key-change-in-production

# ============================================================
# PRIMARY BACKEND: Hugging Face Inference Endpoint (llama.cpp / TGI)
# ============================================================
# The dedicated endpoint URL (root or ending in /v1). Example:
#   HF_ENDPOINT_URL=https://xxxxxxxx.us-east-1.aws.endpoints.huggingface.cloud
HF_ENDPOINT_URL=
# Hugging Face access token used to authenticate to the endpoint.
# NEVER commit a real token. Rotate it if it has ever been shared.
HF_TOKEN=
# Model name to send in the request (llama.cpp ignores it; any value works).
HF_MODEL=tgi
# Text-to-image model on HF Inference Providers (for image generation tool).
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Image provider on HF Inference Providers (nscale returns base64 directly).
HF_IMAGE_PROVIDER=nscale
# Optional: a dedicated HF Inference Endpoint running a text-to-image model
# (e.g. an uncensored FLUX finetune). Takes priority over the provider router.
# Deploy Heartsync/Flux-NSFW-uncensored (or FLUX.1-dev) as an Inference Endpoint
# and paste its URL here. Accepts { inputs } and returns image bytes.
HF_IMAGE_ENDPOINT_URL=
HF_IMAGE_ENDPOINT_MODEL=Flux-NSFW-uncensored
# Make the HF endpoint the default provider for chat (recommended).
DEFAULT_PROVIDER=huggingface
DEFAULT_MODEL=tgi

# ---- Agent tuning (defaults tuned for a large GPU, e.g. A100 80GB) ----
# Max output tokens per model turn.
HF_MAX_TOKENS=8192
# Max tool-calling iterations before the agent must answer.
AGENT_MAX_STEPS=16
# Conversation memory: how many prior messages to include.
AGENT_HISTORY_WINDOW=40
# Sampling temperature.
AGENT_TEMPERATURE=0.7
# Long-form synthesis (deep research) output cap.
AGENT_MAX_SYNTHESIS_TOKENS=8192
# Deep research breadth.
RESEARCH_MAX_QUERIES=6
RESEARCH_MAX_SOURCES=10
# Request timeout in ms (generous for long generations / cold starts).
HF_REQUEST_TIMEOUT_MS=300000

# ---- Guardrails (anti-leak) ----
# Redact system prompt / model identity / secrets from responses. Keep ON in prod.
GUARDRAILS_ENABLED=true
# Set true only for internal debugging to expose model/provider details.
REVEAL_MODEL=false

# ---- Observability (optional) ----
# Sentry error monitoring (backend). Get a DSN at sentry.io. No-op if unset.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenAI (optional fallback)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Deep research web search (optional; falls back to DuckDuckGo when unset)
TAVILY_API_KEY=

# Background task queue (optional; falls back to in-process runner when unset)
REDIS_URL=

# AI Provider API Keys (optional - can also be set in UI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
XAI_API_KEY=your_xai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server
PORT=3001
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3000

# ============================================================
# Accounts, billing & team access
# ============================================================
# The first account to register becomes admin. Optionally pin an admin email:
ADMIN_EMAIL=

# ---- OAuth sign-in (Google / GitHub / Apple) ----
# Buttons appear on the login page only for providers configured here.
# Public backend URL used to build OAuth callback URLs (defaults to request host).
OAUTH_CALLBACK_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple: a Services ID + a Sign in with Apple key (ES256 .p8 contents, newlines as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Transactional email (SMTP) ----
# Sends welcome / voucher / alert emails. No-op (logged) when SMTP_HOST is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Loop GPT <no-reply@loop-gpt.cyou>
SUPPORT_EMAIL=
# Inbound mail webhook secret (POST /api/mail/inbound). Point SES/Mailgun/Postmark here.
MAIL_INBOUND_SECRET=

# ---- Payments (Stripe) ----
# Inert until STRIPE_SECRET_KEY is set. Webhook: POST /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs from your Stripe dashboard for each paid plan.
STRIPE_PRICE_PRO=
STRIPE_PRICE_GOLD=

# Image Generation API
IMAGE_API_URL=http://localhost:8081

