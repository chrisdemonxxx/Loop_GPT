# Database
DATABASE_URL=postgresql://user:password@localhost:5432/loopgpt

# JWT
JWT_SECRET=your-secret-key-change-in-production

# ============================================================
# PRIMARY BACKEND: Hugging Face Inference Endpoint (llama.cpp / TGI)
# ============================================================
# The dedicated endpoint URL (root or ending in /v1). Example:
#   HF_ENDPOINT_URL=https://xxxxxxxx.us-east-1.aws.endpoints.huggingface.cloud
HF_ENDPOINT_URL=
# Hugging Face access token used to authenticate to the endpoint.
# NEVER commit a real token. Rotate it if it has ever been shared.
HF_TOKEN=
# Model name to send in the request (llama.cpp ignores it; any value works).
HF_MODEL=tgi
# Text-to-image model on HF Inference Providers (for image generation tool).
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Image provider on HF Inference Providers (nscale returns base64 directly).
HF_IMAGE_PROVIDER=nscale
# Optional: a dedicated HF Inference Endpoint running a text-to-image model
# (e.g. an uncensored FLUX finetune). Takes priority over the provider router.
# Deploy Heartsync/Flux-NSFW-uncensored (or FLUX.1-dev) as an Inference Endpoint
# and paste its URL here. Accepts { inputs } and returns image bytes.
HF_IMAGE_ENDPOINT_URL=
HF_IMAGE_ENDPOINT_MODEL=Flux-NSFW-uncensored
# Make the HF endpoint the default provider for chat (recommended).
DEFAULT_PROVIDER=huggingface
DEFAULT_MODEL=tgi

# ============================================================
# OPTIONAL SECOND TIER: Loop GPT Large (flagship chat model)
# ============================================================
# A dedicated HF Inference Endpoint serving the flagship GLM deployment
# (vLLM, 256K context). When HF_LARGE_ENDPOINT_URL is set, the
# "Loop GPT Large" tier appears in the UI model picker, /api/models/catalog
# and the public /v1 API; requests with model=loop-chat-large (or any large
# alias) are routed here. Leave empty to hide the tier entirely.
HF_LARGE_ENDPOINT_URL=
# Model name the vLLM server expects. HF dedicated endpoints usually serve
# the model as "/repository" (check <endpoint>/v1/models to confirm).
HF_LARGE_MODEL=/repository
# Advertised context window for the large tier.
HF_LARGE_CONTEXT_TOKENS=262144

# ---- Agent tuning (defaults tuned for a large GPU, e.g. A100 80GB) ----
# Max output tokens per model turn.
HF_MAX_TOKENS=8192
# Max tool-calling iterations before the agent must answer.
AGENT_MAX_STEPS=16
# Conversation memory: how many prior messages to include.
AGENT_HISTORY_WINDOW=40
# Sampling temperature.
AGENT_TEMPERATURE=0.7
# Long-form synthesis (deep research) output cap.
AGENT_MAX_SYNTHESIS_TOKENS=8192
# Deep research breadth.
RESEARCH_MAX_QUERIES=6
RESEARCH_MAX_SOURCES=10
# Request timeout in ms (generous for long generations / cold starts).
HF_REQUEST_TIMEOUT_MS=300000

# ---- Guardrails (anti-leak) ----
# Redact system prompt / model identity / secrets from responses. Keep ON in prod.
GUARDRAILS_ENABLED=true
# Set true only for internal debugging to expose model/provider details.
REVEAL_MODEL=false

# ---- Observability (optional) ----
# Sentry error monitoring (backend). Get a DSN at sentry.io. No-op if unset.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenAI (optional fallback)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Deep research web search (optional; falls back to DuckDuckGo when unset)
TAVILY_API_KEY=

# Background task queue (optional; falls back to in-process runner when unset)
REDIS_URL=

# AI Provider API Keys (optional - can also be set in UI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
XAI_API_KEY=your_xai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server
PORT=3001
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3000

# ============================================================
# Accounts, billing & team access
# ============================================================
# The first account to register becomes admin. Optionally pin an admin email:
ADMIN_EMAIL=

# ---- OAuth sign-in (Google / GitHub / Apple) ----
# Buttons appear on the login page only for providers configured here.
# Public backend URL used to build OAuth callback URLs (defaults to request host).
OAUTH_CALLBACK_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple: a Services ID + a Sign in with Apple key (ES256 .p8 contents, newlines as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Transactional email (SMTP) ----
# Sends welcome / voucher / alert emails. No-op (logged) when SMTP_HOST is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Loop GPT <no-reply@loop-gpt.cyou>
SUPPORT_EMAIL=
# Inbound mail webhook secret (POST /api/mail/inbound). Point SES/Mailgun/Postmark here.
MAIL_INBOUND_SECRET=

# ---- Payments (Stripe) ----
# Inert until STRIPE_SECRET_KEY is set. Webhook: POST /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs from your Stripe dashboard for each paid plan.
STRIPE_PRICE_PRO=
STRIPE_PRICE_GOLD=

# Image Generation API
IMAGE_API_URL=http://localhost:8081


# Dedicated asynchronous text-to-video endpoint. With HF_VIDEO_API unset it must
# accept the standard { inputs, parameters } body and return either MP4 bytes or
# { job_id, status_url, result_url }.
HF_VIDEO_ENDPOINT_URL=
# Set to `lightx2v` for a LightX2V task API (POST /v1/tasks/video/ -> poll
# GET /v1/tasks/:id/status -> GET /v1/tasks/:id/result), e.g. the MiniMax-H3
# dedicated endpoint. The endpoint saves the clip server-side; HF_VIDEO_SAVE_DIR
# must be a path it will serve back (outside its own root it answers 403).
HF_VIDEO_API=
HF_VIDEO_SAVE_DIR=
# Maximum time to wait for a provider job before marking it failed.
HF_VIDEO_MAX_WAIT_MS=600000


# ---- Fleet model router (JEV) ----
# Small, fast OpenAI-compatible deployment that arbitrates ambiguous chat
# turns (rules first; JEV only upgrades the fast default to a heavy tier).
# Unset = deterministic rules only — the chat path never depends on it.
# e.g. the org's GLM-5.3-Flash endpoint (small, quick, snappy).
ROUTER_ENDPOINT_URL=
ROUTER_MODEL=
# Falls back to HF_TOKEN when unset.
ROUTER_API_KEY=
ROUTER_TIMEOUT_MS=3500

# Deterministic media dispatch: a turn pinning exactly one media tool
# (/image → generate_image, /video → generate_video) executes the tool
# directly — the chat model can no longer answer prose where an image was
# asked. The fleet router picks the deployment per use case (MiniMax for
# video, the image Space for images, providers as fallback).
MEDIA_DIRECT_DISPATCH=true

# MiniMax-H3 (LightX2V) dedicated endpoint — VIDEO ONLY (its runner rejects
# image tasks: t2av/i2av/l2av/fl2av/ref2av only). Optional explicit alias;
# HF_VIDEO_ENDPOINT_URL/VIDEO_API_URL are read when this is unset.
MINIMAX_ENDPOINT_URL=


# ---- Bot computer (autonomous agent task worker) ----
# Run the bot worker as a fifth supervised child (staging-runtime.mjs).
BOT_WORKER_ENABLED=false
# Service account identity (find-or-created; never logs in).
BOT_USER_EMAIL=ops-bot@loop-gpt.cyou
# Model override for bot runs; defaults to the HF chat model.
BOT_MODEL=
# Force the execute_code tool's subprocess mode (no Docker daemon on Railway).
SANDBOX_DOCKER=false


# ---- execute_code sandbox provider ----
# '' (auto: docker if present, else subprocess) | hf | docker | subprocess
SANDBOX_PROVIDER=
# HF Sandbox (managed VM isolation) tuning; requires positive HF credit balance.
HF_HUB_ENDPOINT=https://huggingface.co
HF_SANDBOX_NAMESPACE=
HF_SANDBOX_IDLE_TIMEOUT=600
HF_SANDBOX_START_TIMEOUT=120


# ---- Bot dedicated computer (E2B Desktop, Phase 3) ----
# Per-run cloud desktop VMs for computer-enabled bot tasks (live noVNC view + takeover).
E2B_API_KEY=
