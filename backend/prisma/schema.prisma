// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Include the engine that matches the Debian bookworm (OpenSSL 3) runtime image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  // Access control
  role             String   @default("user")  // 'user' | 'admin'
  unlimited        Boolean  @default(false)    // team/unlimited access (usually via voucher)
  emailVerified    Boolean  @default(false)
  stripeCustomerId String?
  stripeSubId      String?

  // Plan & metering (freemium)
  plan             String   @default("free") // 'free' | 'pro'
  credits          Int      @default(30)     // remaining daily message credits
  imageCredits     Int      @default(5)      // remaining daily image credits
  creditsResetAt   DateTime @default(now())
  // Consent to use interactions for product improvement / model training.
  consentTraining  Boolean  @default(false)

  // Lifetime usage counters (fast admin stats without scanning events)
  tokensInTotal    BigInt   @default(0)
  tokensOutTotal   BigInt   @default(0)
  imagesTotal      Int      @default(0)
  messagesTotal    Int      @default(0)
  lastActiveAt     DateTime @default(now())

  // ---- Developer API platform ----
  // Prepaid balance in micro-USD (1_000_000 = $1) so token costs stay exact
  // integers. Credits never expire; top-ups add, usage debits.
  apiBalanceMicros BigInt   @default(0)
  /// null | 'developer' | 'growth' | 'scale' — monthly plan granting a usage discount.
  apiPlan          String?
  apiSubId         String?
  apiPlanRenewsAt  DateTime?
  /// Whether the one-time free preview credit has been granted.
  apiPreviewGranted Boolean @default(false)

  redemptions   VoucherRedemption[]
  usageEvents   UsageEvent[]
  dailyReservations DailyReservation[]
  payments      Payment[]
  tokens        Token[]
  mediaJobs     MediaJob[]
  apiKeys       ApiKey[]
  apiUsage      ApiUsage[]
  apiTopUps     ApiTopUp[]
  apiReservations ApiReservation[]
  privateFiles  PrivateFile[]
  personalWorkspace Workspace? @relation("PersonalWorkspace")
  workspaceMemberships WorkspaceMember[]

  @@index([role])
  @@index([plan])
}

/// A developer API key. The raw secret (`sk-loop-…`) is shown once at creation and
/// only its sha256 hash is stored; `prefix` keeps a masked display value.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    @default("Default key")
  keyHash    String    @unique
  prefix     String // e.g. "sk-loop-a1b2c3" for display
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  usage ApiUsage[]
  reservations ApiReservation[]

  @@unique([id, userId])
  @@index([userId])
  @@index([keyHash])
}

/// One row per billable developer API request.
// Durable Stripe webhook inbox: exactly-once fulfillment processing.
model StripeEventInbox {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  errorCount  Int       @default(0)
  lastError   String?
  payloadJson String
}

model ApiUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  kind       String // 'chat' | 'image' | 'video'
  model      String   @default("")
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  units      Int      @default(0) // images or videos produced
  costMicros BigInt   @default(0) // charged amount in micro-USD (after discount)
  reservationId String? @unique
  reservation ApiReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

/// Prepaid balance top-ups (Stripe payment-mode checkout, voucher, or admin grant).
model ApiTopUp {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMicros  BigInt
  source        String   @default("stripe") // 'stripe' | 'voucher' | 'admin' | 'preview' | 'plan'
  reference     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([source, reference])
}

/// Short-lived tokens for email verification and password reset.
model Token {
  id        String   @id @default(cuid())
  /// SHA-256 digest of the secret sent to the user; never the raw secret.
  token     String   @unique
  type      String   // 'verify' | 'reset'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

/// A redeemable code. `type=unlimited` flips the user to unlimited (team use);
/// `type=credits` tops up message/image credits and optionally upgrades plan.
model Voucher {
  id              String    @id @default(cuid())
  code            String    @unique
  type            String    @default("credits") // 'unlimited' | 'credits'
  plan            String?                        // optional plan to set on redeem (e.g. 'pro')
  credits         Int       @default(0)          // message credits granted
  imageCredits    Int       @default(0)          // image credits granted
  maxRedemptions  Int       @default(1)          // how many distinct users may redeem
  redemptionCount Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  note            String?
  createdAt       DateTime  @default(now())

  redemptions     VoucherRedemption[]

  @@index([active])
}

model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([voucherId, userId])
  @@index([userId])
}

/// One row per billable action, for the admin usage feed and analytics.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // 'chat' | 'agent' | 'research' | 'image'
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  credits   Int      @default(0) // credits deducted for this event
  model     String?
  reservationId String? @unique
  reservation DailyReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([kind])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      // in cents
  currency  String   @default("usd")
  status    String   @default("succeeded") // 'succeeded' | 'pending' | 'failed' | 'refunded'
  provider  String   @default("stripe")
  reference String?  // external payment/session id
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  privateFiles PrivateFile[]
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

enum DailyReservationState {
  reserved
  dispatched
  unknown
  captured
  released
}

/// Daily allowance is available credit, deducted before dispatch. Unknown and
/// stale dispatched work require evidence-based reconciliation, never expiry.
model DailyReservation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  model String
  credits Int
  imageCredits Int
  bypass Boolean
  windowStart DateTime
  state DailyReservationState @default(reserved)
  settlementFingerprint String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usage UsageEvent?
  settlementIntent DailySettlementIntent?
  videoJob AccountedVideoJob?
  requestFingerprint String?
  pricingSnapshot Json?

  @@index([userId, createdAt])
  @@index([state, updatedAt])
}

enum DailySettlementStatus {
  pending
  processing
  succeeded
  conflict
  dead_letter
}

/// Immutable evidence for daily capture; mutable delivery state is lease-fenced.
model DailySettlementIntent {
  reservationId String @id
  reservation DailyReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId String
  kind String
  model String
  tokensIn Int
  tokensOut Int
  images Int
  fingerprint String
  status DailySettlementStatus @default(pending)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  lastErrorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

enum ApiReservationState {
  reserved
  dispatched
  unknown
  captured
  released
}

/// Balance is AVAILABLE credit: creating a hold debits it; settlement returns only
/// the unused portion. Never expire/refund dispatched or unknown holds by age.
/// Reconcile these (and stale dispatched rows after a crash) against provider
/// evidence, using settleReservation with a durable reconciliation reference.
model ApiReservation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  apiKeyId String?
  apiKey ApiKey? @relation(fields: [apiKeyId, userId], references: [id, userId], onDelete: Restrict)
  kind String
  model String
  amountMicros BigInt
  requestFingerprint String
  pricingSnapshot Json?
  state ApiReservationState @default(reserved)
  settlementFingerprint String?
  capturedMicros BigInt?
  evidence Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usage ApiUsage?
  settlementIntent ApiSettlementIntent?
  videoJob AccountedVideoJob?

  @@index([state, updatedAt])
  @@index([userId, createdAt])
}

/// New deduplication identities, separate from immutable historical top-up rows.
/// source/reference is global: reuse for another owner or amount is a conflict.
model ApiCreditIdentity {
  source String
  reference String
  userId String
  amountMicros BigInt
  createdAt DateTime @default(now())
  @@id([source, reference])
}

enum ApiSettlementStatus {
  pending
  processing
  succeeded
  conflict
  dead_letter
}

/// Confirmed server-produced usage only; evidence immutable, delivery lease-fenced.
model ApiSettlementIntent {
  reservationId String @id
  reservation ApiReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  userId String
  apiKeyId String?
  kind String
  model String
  costMicros BigInt
  tokensIn Int
  tokensOut Int
  units Int
  fingerprint String
  reconciliationReference String
  status ApiSettlementStatus @default(pending)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  lastErrorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

model Message {
  id             String       @id @default(cuid())
  role           String       // 'user' or 'assistant'
  content        String       @db.Text
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  
  // New fields for advanced features
  messageType    String       @default("text") // 'text', 'image', 'mixed'
  imageUrl       String?      // URL or base64 data URL for images
  imagePath      String?      // File path for uploaded images
  toolUsed       String?      // Tool used: 'generate-image', 'analyze-image', 'vision-chat', 'mcp', etc.
  metadata       Json?        // Additional metadata as JSON

  @@index([conversationId])
}


/// Durable media-generation work. The worker can resume provider polling after
/// a process restart because provider job URLs are stored with the job.
model MediaJob {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String   @default("video")
  prompt        String   @db.Text
  status        String   @default("queued") // queued | processing | completed | failed | cancelled
  progress      Int      @default(0)
  providerJobId String?
  statusUrl     String?
  resultUrl     String?
  outputUrl     String?
  error         String?
  metadata      Json?
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt
  accountedVideo AccountedVideoJob?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Only these jobs may be dispatched. Legacy MediaJob rows are read-only to workers.
/// No credentials: endpoint/config are bound operator snapshots; token stays in env.
model AccountedVideoJob {
  jobId String @id
  job MediaJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  reservationId String? @unique
  reservation ApiReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  dailyReservationId String? @unique
  dailyReservation DailyReservation? @relation(fields: [dailyReservationId], references: [id], onDelete: Restrict)
  endpoint String
  config Json
  state String @default("queued")
  submittedAt DateTime?
  // Durable upstream occupancy, never released by lease expiry or uncertainty.
  upstreamSlot Boolean @default(false)
  cancelRequested Boolean @default(false)
  attempts Int @default(0)
  failures Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  // Prepared bytes are inaccessible until capture + PrivateFile publication commit.
  stagedArtifact Json?
  updatedAt DateTime @default(now()) @updatedAt

  @@index([state, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([upstreamSlot])
}

/// DB-admin managed singleton. SQL checks and runtime validation fail closed.
model VideoQueuePolicy {
  id Int @id @default(1)
  version Int @default(1)
  revision Int @default(1)
  globalOutstanding Int @default(64)
  userOutstanding Int @default(8)
  globalActive Int @default(8)
  userActive Int @default(2)
}

model Workspace {
  id String @id @default(uuid())
  name String
  personalOwnerId String? @unique
  personalOwner User? @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  connections WorkspaceConnection[]
  conversations Conversation[]
  auditEvents WorkspaceAuditEvent[]
}

enum WorkspaceRole {
  owner
  editor
  viewer
}

model WorkspaceMember {
  workspaceId String
  userId String
  role WorkspaceRole
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([workspaceId, userId])
  @@index([userId])
}

model WorkspaceConnection {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type String
  name String
  encryptedConfig String @db.Text
  configuredFields String[]
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId])
}

model WorkspaceAuditEvent {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId String
  action String
  resourceId String?
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}

/// Private file metadata. Bytes live behind the storage service, never a static mount.
model PrivateFile {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String
  mimeType       String
  size           Int
  sha256         String
  purpose        String   // upload | artifact
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  @@index([userId, createdAt])
  @@index([conversationId])
}
