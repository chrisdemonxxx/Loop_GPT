{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/owned-staging/backend.Dockerfile"
  },
  "deploy": {
    "startCommand": "node scripts/staging-runtime.mjs",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
