# PLACEHOLDERS ONLY. Set secret values through the operator environment/secret manager.
# This file is NOT loaded automatically by Compose or the image.
STAGING_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
STAGING_JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
STAGING_CONNECTION_KEY=REPLACE_WITH_RANDOM_32_BYTES_BASE64
STAGING_STORE_ID=REPLACE_WITH_FRESH_LOWERCASE_UUID
OWNED_WEB_ORIGIN=https://NEW-OWNED-STAGING-HOST.example.invalid

# Railway backend variables (no secret gets passed to the web build):
DATABASE_URL=REPLACE_WITH_NEW_STAGING_POSTGRES_URL
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET
CONNECTION_ENCRYPTION_KEY=REPLACE_WITH_STAGING_CONNECTION_KEY
FRONTEND_URL=https://NEW-OWNED-STAGING-HOST.example.invalid
NODE_ENV=production
ENABLE_DEV_MODE=false
PRIVATE_FILES_STORAGE_MODE=shared-filesystem
PRIVATE_FILES_DIR=/private-store/files
PRIVATE_FILES_STORE_ID=REPLACE_WITH_STAGING_STORE_ID
PRIVATE_FILES_MIN_FREE_BYTES=67108864
STAGING_REPLICAS=1
STAGING_PAYMENTS_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
STRIPE_FULFILLMENT_ENABLED=false
ACCOUNTED_VIDEO_JOBS_ENABLED=false
ACCOUNTED_DAILY_VIDEO_JOBS_ENABLED=false
PORT=3002
STAGING_API_PORT=3001

# Railway web RUNTIME variables. New service names/origins only.
# PORT=8080
# OWNED_WEB_ORIGIN=https://new-owned-staging-host.example.invalid
# API_UPSTREAM=http://new-owned-backend.railway.internal:3001
# Or API_UPSTREAM=https://new-owned-api.example.invalid (domain target port 3001).
